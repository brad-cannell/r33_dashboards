# =============================================================================
# MacOS files
# =============================================================================

# DS_store
**/.DS_Store

# =============================================================================
# R Files
# =============================================================================

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Environment file with secrets (API tokens) - do not commit
.Renviron

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache

# =============================================================================
# Python files
# =============================================================================

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# =============================================================================
# Microsoft files
# =============================================================================

# Ignore all PowerPoint files (modern and old formats)
*.pptx
*.ppt

# Ignore MS Office temporary files that start with ~$
~$*

# =============================================================================
# Media files
# =============================================================================

# None

# =============================================================================
# Other large files
# =============================================================================

# Ignore all zip files
**.zip
/.quarto/

**/*.quarto_ipynb

# =============================================================================
# Quarto render output (regenerated by quarto render)
# =============================================================================

/_site/
/index_files/

# =============================================================================
# Project data
# =============================================================================
# Ignore everything under data/ (PPI + regenerable prep outputs).
# Data is recreated locally by the data_management/ prep scripts (REDCap API).
# Keep only the curated, non-PPI inputs the dashboard build needs.

/data/*
!/data/clinics_physicians.csv
!/data/detect_tool_pilot/
/data/detect_tool_pilot/*
!/data/detect_tool_pilot/link_data/
